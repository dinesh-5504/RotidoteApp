{
  "name": "rotidote-backend",
  "version": "1.0.0",
  "description": "Backend for Rotidote app - Mux Direct Upload integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "render-build": "echo 'Build step not required'",
    "test": "node test-api.js",
    "test:local": "BASE_URL=http://localhost:3000 node test-api.js",
    "test:vercel": "BASE_URL=https://backend-ten-lovat.vercel.app/ node test-api.js",
    "test:render": "BASE_URL=https://rotidoteapp.onrender.com node test-api.js",
    "test:auth": "node run-auth-tests.js",
    "test:auth:local": "cross-env BASE_URL=http://localhost:3000 node run-auth-tests.js",
    "test:auth:vercel": "cross-env BASE_URL=https://backend-ten-lovat.vercel.app/ node run-auth-tests.js",
    "test:auth:render": "cross-env BASE_URL=https://rotidoteapp.onrender.com node run-auth-tests.js",
    "test:auth:simple": "node test-auth.js",
    "test:auth:simple:local": "cross-env BASE_URL=http://localhost:3000 node test-auth.js",
    "test:auth:simple:vercel": "cross-env BASE_URL=https://backend-ten-lovat.vercel.app/ node test-auth.js",
    "test:auth:simple:render": "cross-env BASE_URL=https://rotidoteapp.onrender.com node test-auth.js",
    "test:quick": "node quick-test.js",
    "test:quick:local": "cross-env BASE_URL=http://localhost:3000 node quick-test.js",
    "test:quick:vercel": "cross-env BASE_URL=https://backend-ten-lovat.vercel.app/ node quick-test.js",
    "test:quick:render": "cross-env BASE_URL=https://rotidoteapp.onrender.com node quick-test.js",
    "test:scaffold": "node test-scaffold.js",
    "test:scaffold:local": "cross-env BASE_URL=http://localhost:3000 node test-scaffold.js",
    "test:scaffold:render": "cross-env BASE_URL=https://rotidoteapp.onrender.com node test-scaffold.js"
  },
  "keywords": [
    "mux",
    "video",
    "upload",
    "backend"
  ],
  "author": "Rotidote Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "7.11.3",
    "@mux/mux-node": "^12.4.0",
    "axios": "^1.11.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "13.5.0",
    "google-auth-library": "10.3.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": "20.x"
  }
}
